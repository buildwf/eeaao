{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "void/env",
      "@cloudflare/workers-types"
    ],
    "paths": {
      "@schema": [
        "./db/schema.ts"
      ],
      "@eeao/void": [
        "../../typescript/packages/void/src/index.ts"
      ],
      "@eeao/void/*": [
        "../../typescript/packages/void/src/*.ts"
      ],
      "@eeao/*": [
        "../../typescript/packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "middleware",
    "db",
    ".void/**/*.d.ts",
    "../../typescript/packages/void/src/virtual.d.ts"
  ]
}