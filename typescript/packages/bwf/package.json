{
  "name": "@eeao/bwf",
  "version": "0.1.0",
  "description": "Zero-setup eeao for bwf: a Vite plugin, one middleware file, live queries and the data layer hookup",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "default": "./dist/live.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    }
  },
  "peerDependencies": {
    "@buildwf/bwf": "^1.9.1",
    "vite": "^8.0.0",
    "react": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@eeao/ai": "0.1.0",
    "@eeao/analytics": "0.1.0",
    "@eeao/core": "0.1.0",
    "@eeao/http": "0.1.0",
    "@eeao/live": "0.1.0",
    "@eeao/mcp": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@buildwf/bwf": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildwf/realtime.git",
    "directory": "typescript/packages/bwf"
  },
  "homepage": "https://github.com/buildwf/realtime#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "cp ../../../LICENSE LICENSE"
  }
}
