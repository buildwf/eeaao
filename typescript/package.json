{
  "name": "eeao-ts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p packages/core/type-tests/tsconfig.json && tsc -p packages/core/type-tests/tsconfig.perf.json && tsc -p examples/contacts-worker/tsconfig.json",
    "test": "vitest run",
    "test:types": "node scripts/type-errors.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run test:types && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^22.20.5",
    "@valibot/to-json-schema": "^1.8.0",
    "agents": "^0.33.0",
    "expect-type": "^1.4.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1",
    "zod": "^4.6.7"
  }
}
